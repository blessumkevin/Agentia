<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Tier_1</name>
        <label>Assign Tier 1</label>
        <locationX>352</locationX>
        <locationY>362</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Tier_2</name>
        <label>Assign Tier 2</label>
        <locationX>176</locationX>
        <locationY>362</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Tier_3</name>
        <label>Assign Tier 3</label>
        <locationX>0</locationX>
        <locationY>362</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Price_Tier</name>
        <label>Check Price Tier</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Assign_Tier_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tier 1 (1000+)</defaultConnectorLabel>
        <rules>
            <name>Is_Tier_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tier_3</targetReference>
            </connector>
            <label>Price less than $500 (Tier 3)</label>
        </rules>
        <rules>
            <name>Is_Tier_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tier_2</targetReference>
            </connector>
            <label>Price $500 to $999.99 (Tier 2)</label>
        </rules>
    </decisions>
    <description>Record-triggered flow that automatically sets the Price Tier picklist on a Bicycle record based on the Price field value. Tier 3 = below $500, Tier 2 = $500-$999.99, Tier 1 = $1000 and above.</description>
    <label>Bicycle Price Tier Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Bicycle_Record</name>
        <label>Update Bicycle Record</label>
        <locationX>176</locationX>
        <locationY>482</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Check_Price_Tier</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1</triggerOrder>
</Flow>
