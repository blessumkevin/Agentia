<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Tier_1</name>
        <label>Set Tier 1</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_2</name>
        <label>Set Tier 2</label>
        <locationX>440</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_3</name>
        <label>Set Tier 3</label>
        <locationX>704</locationX>
        <locationY>288</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Price_Tier</name>
        <label>Check Price Tier</label>
        <locationX>440</locationX>
        <locationY>168</locationY>
        <defaultConnector>
            <targetReference>Set_Tier_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tier 3 (Less than $500)</defaultConnectorLabel>
        <rules>
            <name>Is_Tier_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_1</targetReference>
            </connector>
            <label>Tier 1 ($1000 or more)</label>
        </rules>
        <rules>
            <name>Is_Tier_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_2</targetReference>
            </connector>
            <label>Tier 2 ($500 to $999.99)</label>
        </rules>
    </decisions>
    <description>Record-triggered flow that automatically sets the Price Tier field on a Bicycle record based on the Price value. Tier 1 = $1000 or more, Tier 2 = $500 to $999.99, Tier 3 = less than $500.</description>
    <label>Bicycle Price Tier Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Bicycle_Record</name>
        <label>Update Bicycle Record</label>
        <locationX>440</locationX>
        <locationY>408</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <elementReference>$Record.Price_Tier__c</elementReference>
            </value>
        </inputAssignments>
        <object>Bicycle__c</object>
    </recordUpdates>
    <start>
        <locationX>440</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>Check_Price_Tier</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Price__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
