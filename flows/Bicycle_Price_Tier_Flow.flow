<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Tier_1</name>
        <label>Set Tier 1</label>
        <locationX>50</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Tier_2</name>
        <label>Set Tier 2</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Tier_3</name>
        <label>Set Tier 3</label>
        <locationX>302</locationX>
        <locationY>242</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Price_Range</name>
        <label>Check Price Range</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Tier_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Less than $500 (Tier 3)</defaultConnectorLabel>
        <rules>
            <name>Price_1000_or_More</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_1</targetReference>
            </connector>
            <label>$1000 or More (Tier 1)</label>
        </rules>
        <rules>
            <name>Price_500_to_999</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_2</targetReference>
            </connector>
            <label>$500 to $999 (Tier 2)</label>
        </rules>
    </decisions>
    <description>Automatically assigns Price Tier based on the Bicycle Price field. Tier 1: $1000+, Tier 2: $500-$999, Tier 3: &lt;$500</description>
    <label>Bicycle Price Tier Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Price_Range</targetReference>
        </connector>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
