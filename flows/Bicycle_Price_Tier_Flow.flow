<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Tier_1</name>
        <label>Set Price Tier = Tier 1</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Tier_2</name>
        <label>Set Price Tier = Tier 2</label>
        <locationX>440</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Tier_3</name>
        <label>Set Price Tier = Tier 3</label>
        <locationX>704</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Price_Tier__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Tier_1</name>
        <label>Is Price &gt;= $1,000?</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Check_Tier_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Tier_1_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1000.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tier_1</targetReference>
            </connector>
            <label>Yes - Tier 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Tier_2</name>
        <label>Is Price &gt;= $500?</label>
        <locationX>440</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Assign_Tier_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Tier 3</defaultConnectorLabel>
        <rules>
            <name>Tier_2_Rule</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>500.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Tier_2</targetReference>
            </connector>
            <label>Yes - Tier 2</label>
        </rules>
    </decisions>
    <description>Automatically assigns the Price Tier field on Bicycle__c records based on the Price field value. Tier 1 = $1000+, Tier 2 = $500-$999.99, Tier 3 = less than $500.</description>
    <label>Bicycle Price Tier Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Bicycle_Record</name>
        <label>Update Bicycle Record</label>
        <locationX>440</locationX>
        <locationY>360</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <elementReference>$Record.Price_Tier__c</elementReference>
            </value>
        </inputAssignments>
        <object>Bicycle__c</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Tier_1</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Price__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
