<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Price_Tier</name>
        <label>Check Price Tier</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Update_Tier_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tier 3 (Below 225)</defaultConnectorLabel>
        <rules>
            <name>Is_Tier_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>750.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tier_1</targetReference>
            </connector>
            <label>Is Tier 1 (750+)?</label>
        </rules>
        <rules>
            <name>Is_Tier_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>225.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Tier_2</targetReference>
            </connector>
            <label>Is Tier 2 (225-749)?</label>
        </rules>
    </decisions>
    <description>Automatically sets the Price Tier field on a Bicycle record based on the Price value. Tier 1 = 750+, Tier 2 = 225-749, Tier 3 = below 225.</description>
    <label>Bicycle Price Tier</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Tier_1</name>
        <label>Set Price Tier 1</label>
        <locationX>0</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Tier_2</name>
        <label>Set Price Tier 2</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Tier_3</name>
        <label>Set Price Tier 3</label>
        <locationX>352</locationX>
        <locationY>400</locationY>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Check_Price_Tier</targetReference>
        </connector>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
