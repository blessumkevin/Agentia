<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Tier_1</name>
        <label>Set Price Tier = Tier 1</label>
        <locationX>0</locationX>
        <locationY>254</locationY>
        <assignmentItems>
            <assignToReference>varPriceTier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 1</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_2</name>
        <label>Set Price Tier = Tier 2</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <assignmentItems>
            <assignToReference>varPriceTier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 2</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Tier_3</name>
        <label>Set Price Tier = Tier 3</label>
        <locationX>352</locationX>
        <locationY>254</locationY>
        <assignmentItems>
            <assignToReference>varPriceTier</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tier 3</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Bicycle_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Evaluate_Price_Tier</name>
        <label>Evaluate Price Tier</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Tier_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tier 3 (Price &lt;= 220)</defaultConnectorLabel>
        <rules>
            <name>Is_Tier_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>740.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_1</targetReference>
            </connector>
            <label>Price &gt; 740 (Tier 1)</label>
        </rules>
        <rules>
            <name>Is_Tier_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Price__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>220.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Tier_2</targetReference>
            </connector>
            <label>Price &gt; 220 (Tier 2)</label>
        </rules>
    </decisions>
    <label>Bicycle Price Tier</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Bicycle_Record</name>
        <label>Update Bicycle Record</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Price_Tier__c</field>
            <value>
                <elementReference>varPriceTier</elementReference>
            </value>
        </inputAssignments>
        <object>Bicycle__c</object>
    </recordUpdates>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Price_Tier</targetReference>
        </connector>
        <object>Bicycle__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varPriceTier</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
