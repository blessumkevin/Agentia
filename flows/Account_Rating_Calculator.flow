<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Invokes AccountRatingCalculator to compute and assign the Hot/Warm/Cold rating.</description>
        <name>Calculate_Rating</name>
        <label>Calculate Rating</label>
        <locationX>264</locationX>
        <locationY>132</locationY>
        <actionName>AccountRatingCalculator</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Update_Account_Rating</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>AccountRatingCalculator</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <label>Account Rating Calculator</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Placeholder update element required for record-triggered flow structure. Actual rating update is performed by the Apex action.</description>
        <name>Update_Account_Rating</name>
        <label>Update Account Rating</label>
        <locationX>264</locationX>
        <locationY>252</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Calculate_Rating</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>AnnualRevenue</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>NumberOfEmployees</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
